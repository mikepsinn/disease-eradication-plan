on:
  workflow_dispatch:
  push:
    branches: [develop]
  pull_request:
    branches: [develop]

name: Build and Deploy Manual Site

permissions:
  contents: read

concurrency:
  group: "manual-deploy"
  cancel-in-progress: true

jobs:
{% for job in jobs %}
  build-{{ job.config_name }}:
    name: "{{ job.display_name }}"
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Cache Quarto freeze
        uses: actions/cache@v4
        with:
          path: _freeze
          key: quarto-freeze-{{ job.config_name }}-{% raw %}${{ hashFiles('**/*.qmd', '**/*.ipynb') }}{% endraw %}
          restore-keys: |
            quarto-freeze-{{ job.config_name }}-
            quarto-freeze-

      - name: Set up Quarto
        uses: quarto-dev/quarto-actions/setup@v2

      - name: Cache validation results
        uses: actions/cache@v4
        with:
          path: .cache
          key: validation-cache-{% raw %}${{ runner.os }}{% endraw %}-{% raw %}${{ hashFiles('.cache/pdf-validation-cache.json') }}{% endraw %}
          restore-keys: |
            validation-cache-{% raw %}${{ runner.os }}{% endraw %}-

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Set up pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'pnpm'

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true

      - name: Install Graphviz
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y graphviz

      - name: Install Python dependencies
        run: uv pip install --system -r requirements.txt

      - name: Install dih_models package
        run: uv pip install --system -e .

      - name: Install Node dependencies
        run: pnpm install --frozen-lockfile

      - name: Install Jupyter kernel
        run: |
          python -m ipykernel install --user --name dih-project-kernel --display-name "DIH Project"

      - name: "Render {{ job.display_name }} (HTML)"
        run: python scripts/render-quarto.py {{ job.config_name }} --to html
        env:
          GOOGLE_GENERATIVE_AI_API_KEY: {% raw %}${{ (secrets.LLM_VALIDATION == 'true' || github.ref == 'refs/heads/develop') && secrets.GOOGLE_GENERATIVE_AI_API_KEY || '' }}{% endraw %}
        timeout-minutes: {{ job.timeout_minutes }}

      - name: Upload build logs on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: build-logs-{{ job.config_name }}
          path: |
            logs/build-{{ job.config_name }}.log
            _build_temp/{{ job.config_name }}/*.log
            _build_temp/{{ job.config_name }}/**/*.log
          retention-days: 7

      - name: "Deploy {{ job.display_name }} to Netlify"
        if: {% raw %}${{ (github.event_name == 'push' && github.ref == 'refs/heads/develop') || (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/develop') }}{% endraw %}
        run: |
          npm install -g netlify-cli
          netlify deploy \
            --dir='{{ job.build_dir }}' \
            --prod \
            --no-build \
            --message="Deploy {{ job.config_name }} from {% raw %}${{ github.ref_name }}{% endraw %}"
        env:
          NETLIFY_AUTH_TOKEN: {% raw %}${{ secrets.NETLIFY_AUTH_TOKEN }}{% endraw %}
          NETLIFY_SITE_ID: {{ job.netlify_site_id }}
        timeout-minutes: 5
{% endfor %}
