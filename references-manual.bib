  author = {Satterthwaite, Mark Allen},
  year = {1975},
  journal = {Journal of Economic Theory},
  volume = {10},
  number = {2},
  pages = {187-217},
  doi = {10.1016/0022-0531(75)90050-2},
  abstract = {Satterthwaite proved independently of Gibbard (1973) that any voting mechanism for three or more alternatives that is strategy-proof and non-imposed must be dictatorial. This Gibbard-Satterthwaite theorem establishes fundamental limits on voting mechanisms: no non-trivial voting procedure can be immune to strategic manipulation. The result connects Arrow's impossibility theorem in social choice theory to mechanism design, showing that the inability to prevent strategic voting is a deep structural feature of democratic systems, not a fixable design flaw.},
}
