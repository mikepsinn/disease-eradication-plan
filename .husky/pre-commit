#!/usr/bin/env sh
set -eu

if [ -f ".venv/Scripts/python.exe" ]; then
    PYTHON_CMD=".venv/Scripts/python.exe"
elif [ -f ".venv/bin/python" ]; then
    PYTHON_CMD=".venv/bin/python"
else
    PYTHON_CMD="python"
fi

START_TIME=$(date +%s)

if ! pnpm exec pyright --version >/dev/null 2>&1; then
    echo "Pyright is not installed. Run: pnpm install --frozen-lockfile"
    exit 1
fi

echo "Running Python type check..."
if ! pnpm exec pyright dih_models scripts; then
    echo "Python type check failed. Fix Pyright/Pylance errors before committing."
    exit 1
fi

echo "Running read-only pre-render validation..."
if ! "$PYTHON_CMD" -u scripts/pre-render-validation.py; then
    echo "Pre-render validation failed. Fix the errors before committing."
    exit 1
fi

END_TIME=$(date +%s)
echo "Pre-commit checks passed in $((END_TIME - START_TIME)) seconds."
