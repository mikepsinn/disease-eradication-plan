{
  "headers": [
    {
      "source": "/api/chat",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/api/visuals",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/json/:path*", "destination": "https://manual.warondisease.org/assets/json/:path*" },
    { "source": "/assets/image-index.json", "destination": "https://manual.warondisease.org/assets/image-index.json" }
  ]
}
