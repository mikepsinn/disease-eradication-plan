  author = {{Composite estimate based on Orphanet}},
  year = {},
  note = {Composite estimate based on Orphanet, FDA approval data, and queue theory},
  abstract = {Queue-based calculation: ~7,000 diseases without effective treatment ÷ ~15 diseases getting first treatment per year = ~467 years for the average disease to receive a cure under the status quo system. This is consistent with the fact that only 5\% of rare diseases have treatments after 40+ years of the Orphan Drug Act. Well-funded diseases may take 30-50 years; underfunded diseases 100-500+ years; and neglected diseases effectively never within human planning horizons.},
