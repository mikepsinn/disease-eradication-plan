@article{fda-pre-1962-mandate,
  title = {FDA mandate pre-1962 focused on safety, not efficacy},
  author = {Wikipedia},
  year = {},
  journal = {Wikipedia: Kefauver-Harris Amendment},
  url = {https://en.wikipedia.org/wiki/Kefauver–Harris_Amendment},
  urldate = {2025-01-20},
  note = {Wikipedia: Kefauver-Harris Amendment | FDA: Promoting Safe \& Effective Drugs 100 Years | PMC: Kefauver-Harris Amendments at 50},
  abstract = {Pre-1962: 1938 Food, Drug and Cosmetic Act required only that drugs be safe for use FDA regulated safety only, not efficacy before 1962 1962 Kefauver-Harris Amendment: Added efficacy requirement after thalidomide tragedy JFK signed amendment: October 10, 1962 Post-1962: FDA requires "adequate and well-controlled investigations" proving both safety AND efficacy Also added: Informed consent requirement, adverse event reporting to FDA Note: 1962 amendment fundamentally changed FDA from safety-only to safety-and-efficacy regulator, laying groundwork for phased clinical trial system we have today Additional sources: https://en.wikipedia.org/wiki/Kefauver–Harris_Amendment | https://www.fda.gov/about-fda/histories-product-regulation/promoting-safe-effective-drugs-100-years | https://pmc.ncbi.nlm.nih.gov/articles/PMC4101807/},
}

