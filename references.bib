@misc{world-resources-institute-2019,
  title = {Porto Alegre: Participatory budgeting and the challenge of sustaining transformative change},
  author = {Abers, Rebecca and Brand{\~a}o, Igor and King, Robin and Votto, Daniely},
  year = {2018},
  url = {https://www.wri.org/research/porto-alegre-participatory-budgeting-and-challenge-sustaining-transformative-change},
  urldate = {2025-01-20},
  note = {Abers, R., Brandão, I., King, R., \& Votto, D. (2018). Porto Alegre: Participatory budgeting and the challenge of sustaining transformative change. World Resources Institute. | PDF},
  abstract = {Examines transformative urban change in Porto Alegre, Brazil, through the lens of participatory budgeting. However, political support for participatory budgeting in its birthplace has declined through the years, culminating in its suspension in Porto Alegre in 2017. The success of participatory budgeting as a tool of transformative urban change is contingent on four conditions: (1) well-structured participatory arrangements to ensure participation from a wide range of actors across society; (2) adequate financial resources; (3) political commitment and flexibility to adjust to changing political realities; and (4) government commitment to implement the proposals the process generates. Additional sources: https://www.wri.org/research/porto-alegre-participatory-budgeting-and-challenge-sustaining-transformative-change | https://www.oidp.net/docs/repo/doc415.pdf},
}

