@article{ody2019,
  title = {Decreases in Readmissions Credited to Medicare's Program to Reduce Hospital Readmissions Have Been Overstated},
  author = {Ody, Christopher and Msall, Lucy and Dafny, Leemore S. and Grabowski, David C. and Cutler, David M.},
  year = {2019},
  journal = {Health Affairs},
  volume = {38},
  number = {1},
  pages = {36-43},
  doi = {10.1377/hlthaff.2018.05178},
  abstract = {Analysis found that 20-40\% of the decline in hospital readmissions attributed to Medicare's Hospital Readmissions Reduction Program (HRRP) was due to changes in patient observation status rather than genuine improvements in care quality. Hospitals classified more patients as "observation" rather than "admitted," avoiding readmission penalties without actually reducing returns to the hospital. This illustrates how metric-bound systems can be gamed through definitional manipulation.},
}

