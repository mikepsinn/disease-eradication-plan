# AI Provider API Keys
# You only need the API key(s) for the model(s) you want to use

# OpenAI API Keys
# Get your API key at: https://platform.openai.com/api-keys
# Pricing: https://openai.com/pricing
OPENAI_API_KEY=sk-...

# Anthropic API Keys
# Get your API key at: https://console.anthropic.com/
# Pricing: https://www.anthropic.com/pricing
ANTHROPIC_API_KEY=sk-...

# Perplexity API Keys
# Get your API key at: https://www.perplexity.ai/settings/api
# Pricing: https://www.perplexity.ai/pricing
PERPLEXITY_API_KEY=pplx-...

# Google API Keys (Gemini)
# Get your API key at: https://makersuite.google.com/app/apikey
# Pricing: https://ai.google.dev/pricing
GOOGLE_GENERATIVE_AI_API_KEY=...

# DeepSeek API Keys
# Get your API key at: https://platform.deepseek.com/
# Pricing: https://platform.deepseek.com/pricing
DEEPSEEK_API_KEY=...

# Model Selection
# Choose one of the following models:

# OpenAI Models (https://platform.openai.com/docs/models):
# - gpt-4-turbo (default) - Most capable GPT-4 model, optimized for speed
# - gpt-4 - More reliable, slower than turbo
# - gpt-3.5-turbo - Fastest, most cost-effective

# Anthropic Models (https://docs.anthropic.com/claude/docs/models-overview):
# - claude-3-opus - Most capable Claude model
# - claude-3-sonnet - Balanced performance and speed
# - anthropic/claude-3-opus - Same as above, alternate naming
# - anthropic/claude-3-sonnet - Same as above, alternate naming

# Perplexity Models (https://docs.perplexity.ai/docs/model-cards):
# - sonar-small-chat - 7B parameter model
# - sonar-medium-chat - 13B parameter model
# - sonar-large-chat - 70B parameter model

# Google Gemini Models (https://ai.google.dev/gemini-api/docs/models):
# - gemini-3-flash-preview - Fast, efficient model
# - gemini-3.1-pro-preview - Most capable model

# DeepSeek Models (https://platform.deepseek.com/docs/models):
# - deepseek-chat - General chat model
# - deepseek-reasoner - Enhanced reasoning capabilities

AI_MODEL=gemini-3-flash-preview

# Note: You only need to provide the API key for the provider you're using.
# The model you select must match one of the providers you have an API key for.

# AWS credentials (if using S3 backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_PUBLIC_URL=

# AWS Configuration
S3_AWS_BUCKET=

# Cloudflare R2 (audiobook/media hosting at static.warondiease.org)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_PUBLIC_URL=https://static.warondiease.org

# Optional Image Directory (default: 'img')
# IMAGE_DIR= 

# Set to false to disable automatic catalog updates from S3 (default: true)
UPDATE_IMAGE_CATALOG_FROM_S3=false

# Database Configuration
DB_HOST=remote.database.host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# SSH Configuration
SSH_HOST=your.ssh.host
SSH_USER=your_ssh_username
SSH_PORT=22
SSH_PRIVATE_KEY_PATH=/path/to/your/private/key

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_ACCESS_TOKEN=your_access_token
GOOGLE_REFRESH_TOKEN=your_refresh_token

# Model Selection
# Choose one of the following models:

# OpenAI Models:
# - gpt-4-turbo (default)
# - gpt-4
# - gpt-3.5-turbo

# Anthropic Models:
# - claude-3-opus
# - claude-3-sonnet
# - anthropic/claude-3-opus
# - anthropic/claude-3-sonnet

# Perplexity Models:
# - sonar-small-chat
# - sonar-medium-chat
# - sonar-large-chat

# Google Gemini Models:
# - gemini-3-flash-preview
# - gemini-3.1-pro-preview

# DeepSeek Models:
# - deepseek-chat
# - deepseek-reasoner

# Note: You only need to provide the API key for the provider you're using.
# The model you select must match one of the providers you have an API key for. 

GITHUB_OWNER=mikepsinn
GITHUB_REPO=decentralized-institutes-of-health
# 
GITHUB_TOKEN=

# VoltAgent Server Configuration
# Port for the VoltAgent HTTP server (default: 3141)
VOLTAGENT_PORT=3141
# Full server URL (optional, will be constructed from VOLTAGENT_PORT if not set)
# VOLTAGENT_URL=http://localhost:3141

# Netlify Deployment Configuration
# Get auth token at: https://app.netlify.com/user/applications/personal
# Get site IDs from each site's settings
NETLIFY_AUTH_TOKEN=

# Site IDs for each paper/site deployment
NETLIFY_MAIN_SITE_ID=4e36b0d6-9b80-49e2-bf16-eb4d2f79f062
NETLIFY_ECONOMICS_SITE_ID=8cb62a4c-0a10-4a92-a9ab-088c5b2cf094
NETLIFY_WISHOCRACY_SITE_ID=6d3175fc-5866-4d09-985d-aebe008a4966
NETLIFY_IAB_SITE_ID=8f7611db-1075-48a2-abd8-7f77f55538f9
NETLIFY_DFDA_SPEC_SITE_ID=01e9af64-b6d0-48ee-8c3d-43994745ac3f          # spec.dfda.earth
NETLIFY_DFDA_IMPACT_SITE_ID=a314a33e-3155-4067-8624-706266899419   # dfda-impact.warondisease.org


# https://zenodo.org/account/settings/applications/tokens/
ZENODO_TOKEN=

# =============================================================================
# Content Distribution (scripts/distribute/distributor.py)
# =============================================================================
# Run: python scripts/distribute/distributor.py
# Only configure the platforms you want to use. Unconfigured ones are skipped.

# Twitter/X
# Create app + get keys: https://developer.x.com/en/portal/dashboard
# Requires "Free" tier ($0) for write access to v2 API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Bluesky
# Generate app password: https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=warondisease.bsky.social
BLUESKY_APP_PASSWORD=

# Reddit
# Create app (script type): https://www.reddit.com/prefs/apps
# Use "script" type, redirect URI: http://localhost:8080
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=healthpolicy,publichealth,science,Futurology

# Discord
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Telegram
# Message @BotFather > /newbot > copy token
# Add bot to channel as admin, use @channel_username as chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Medium
# Get integration token: https://medium.com/me/settings/security
# Note: API is deprecated but still works. Posts created as drafts.
MEDIUM_TOKEN=

# LinkedIn (complex setup - consider skipping)
# Create app: https://www.linkedin.com/developers/apps
# Need "Share on LinkedIn" (w_member_social) permission + OAuth2 flow
# Get person URN: https://api.linkedin.com/v2/userinfo
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=